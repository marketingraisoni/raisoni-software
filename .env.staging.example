# Staging: http://<server-ip>:3002
PORT=3002
HOST=0.0.0.0
DATABASE_NAME=raisoni_software_staging
MONGODB_URI=mongodb://127.0.0.1:27017/raisoni_software_staging
USE_EMBEDDED_MONGODB=false
USE_EMBEDDED_MONGODB_FALLBACK=true
AUTO_BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30
JWT_SECRET=replace_with_a_unique_staging_secret_at_least_32_characters

# Raisoni ERP - development backend settings. Copy to .env.development
# (scripts/setup.ps1 does this automatically and generates a JWT secret).
PORT=9090
HOST=0.0.0.0
DATABASE_NAME=raisoni_software_development
MONGODB_URI=mongodb://127.0.0.1:27017/raisoni_software_development

# Use the MongoDB Windows service when it is running; otherwise start the bundled
# mongod (resources/mongodb/mongod.exe, fetched by "npm run mongodb:download").
USE_EMBEDDED_MONGODB=false
USE_EMBEDDED_MONGODB_FALLBACK=true
# How long to wait for the MongoDB service after a reboot before falling back/failing.
MONGODB_CONNECT_RETRIES=1
MONGODB_RETRY_DELAY_MS=3000

AUTO_BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30
JWT_SECRET=replace-with-a-random-64-character-hex-string

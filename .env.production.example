# Production: http://<server-ip>:3000
PORT=3000
HOST=0.0.0.0
DATABASE_NAME=raisoni_software_production
MONGODB_URI=mongodb://127.0.0.1:27017/raisoni_software_production
USE_EMBEDDED_MONGODB=false
USE_EMBEDDED_MONGODB_FALLBACK=false
AUTO_BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_DAYS=30
JWT_SECRET=replace_with_a_strong_unique_production_secret_at_least_32_characters

# Shared settings loaded for every environment.
# Copy the matching .env.<environment>.example file as well.
JWT_EXPIRES_IN=8h
JWT_REMEMBER_ME_EXPIRES_IN=30d
CORS_ORIGIN=*
APP_NAME=Raisoni ERP
APP_VERSION=1.0.0

# Redis (optional). If it is not running, the backend uses an in-memory cache.
REDIS_ENABLED=true
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Logs are written to data/<environment>/logs. Levels: debug | http | info | warn | error
# LOG_LEVEL=info

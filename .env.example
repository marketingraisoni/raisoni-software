# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Connection (Default local MongoDB instance)
# Format: mongodb://127.0.0.1:27017/<dbname>
MONGODB_URI=mongodb://127.0.0.1:27017/raisoni_software_demo

# Fallback: If local MongoDB Community Server is not yet running on Windows,
# enable embedded fallback so the demo starts smoothly for testing/evaluation
USE_EMBEDDED_MONGODB_FALLBACK=true

# Security & Authentication
# Generate a cryptographically secure 64-char key using crypto.randomBytes(32).toString('hex')
JWT_SECRET=replace_this_with_a_secure_random_key_min_32_characters_long_0987654321
JWT_EXPIRES_IN=8h

# CORS configuration: allow LAN subnet access or specific client IP origins
CORS_ORIGIN=*

# Application Branding
APP_NAME=Raisoni Software Demo
APP_VERSION=1.0.0

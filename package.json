{
  "name": "raisoni-erp",
  "version": "1.0.4",
  "description": "Offline-capable Windows desktop business management application for shared LAN",
  "main": "desktop/main.cjs",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"cross-env APP_ENV=development NODE_ENV=development node --watch backend/server.js\" \"npm --prefix frontend run dev -- --mode development\"",
    "dev:backend": "cross-env APP_ENV=development NODE_ENV=development node --watch backend/server.js",
    "dev:frontend": "npm --prefix frontend run dev -- --mode development",
    "dev:staging": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"cross-env APP_ENV=staging NODE_ENV=production node --watch backend/server.js\" \"npm --prefix frontend run dev -- --mode staging\"",
    "pm2:start": "pm2 start backend/ecosystem.config.cjs && pm2 save --force",
    "pm2:restart": "pm2 restart raisoni-backend --update-env && pm2 save --force",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs raisoni-backend",
    "pm2:stop": "pm2 stop raisoni-backend",
    "production": "npm run frontend:build && npm run start:production",
    "start": "npm run start:production",
    "start:development": "cross-env APP_ENV=development NODE_ENV=development node backend/server.js",
    "start:staging": "cross-env APP_ENV=staging NODE_ENV=production node backend/server.js",
    "start:production": "cross-env APP_ENV=production NODE_ENV=production node backend/server.js",
    "server": "cross-env APP_ENV=development NODE_ENV=development node --watch backend/server.js",
    "seed": "npm run seed:development",
    "seed:development": "cross-env APP_ENV=development NODE_ENV=development node backend/scripts/seed.js",
    "seed:staging": "cross-env APP_ENV=staging NODE_ENV=production node backend/scripts/seed.js",
    "seed:production": "cross-env APP_ENV=production NODE_ENV=production node backend/scripts/seed.js",
    "backup": "npm run backup:production",
    "backup:development": "cross-env APP_ENV=development NODE_ENV=development node backend/scripts/backup.js",
    "backup:staging": "cross-env APP_ENV=staging NODE_ENV=production node backend/scripts/backup.js",
    "backup:production": "cross-env APP_ENV=production NODE_ENV=production node backend/scripts/backup.js",
    "env:development": "cross-env APP_ENV=development NODE_ENV=development node backend/scripts/show-environment.js",
    "env:staging": "cross-env APP_ENV=staging NODE_ENV=production node backend/scripts/show-environment.js",
    "env:production": "cross-env APP_ENV=production NODE_ENV=production node backend/scripts/show-environment.js",
    "test": "node --test backend/tests/*.test.js",
    "frontend": "npm run frontend:dev",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm run frontend:build:production",
    "production:build": "npm run frontend:build",
    "frontend:build:development": "npm --prefix frontend run build -- --mode development",
    "frontend:build:staging": "npm --prefix frontend run build -- --mode staging",
    "frontend:build:production": "npm --prefix frontend run build -- --mode production",
    "desktop": "cross-env APP_ENV=production NODE_ENV=production electron desktop/main.cjs",
    "desktop:development": "cross-env APP_ENV=development NODE_ENV=development electron desktop/main.cjs",
    "desktop:staging": "cross-env APP_ENV=staging NODE_ENV=production electron desktop/main.cjs",
    "pack": "electron-builder --dir",
    "desktop:mongodb": "node scripts/download-mongodb.cjs",
    "desktop:verify": "node scripts/verify-electron-package.cjs",
    "dist": "npm run dist:all",
    "dist:all": "npm run desktop:mongodb && node scripts/package-electron.cjs all --bump-version",
    "dist:development": "npm run desktop:mongodb && node scripts/package-electron.cjs development",
    "dist:staging": "npm run desktop:mongodb && node scripts/package-electron.cjs staging",
    "dist:production": "npm run desktop:mongodb && node scripts/package-electron.cjs production"
  },
  "keywords": [
    "electron",
    "react",
    "express",
    "mongodb",
    "lan-software",
    "offline-first"
  ],
  "author": "Raisoni ERP",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.1.3",
    "mongoose": "^8.9.5",
    "pm2": "^7.1.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.raisoni.erp",
    "productName": "Raisoni ERP",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "backend/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/mongodb/mongod.exe",
        "to": "mongodb/mongod.exe"
      }
    ],
    "win": {
      "icon": "frontend/public/images/logo.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Raisoni ERP",
      "installerSidebar": "installer-assets/installer-sidebar.bmp",
      "uninstallerSidebar": "installer-assets/installer-sidebar.bmp"
    }
  }
}

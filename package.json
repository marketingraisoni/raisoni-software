{
  "name": "raisoni-erp",
  "version": "1.0.7",
  "description": "Windows desktop business management application with a shared LAN server",
  "main": "desktop/main.cjs",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "postinstall": "npm --prefix frontend run generate:routes",
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"cross-env APP_ENV=development NODE_ENV=development node --watch backend/server.js\" \"npm --prefix frontend run dev -- --mode development\"",
    "dev:backend": "cross-env APP_ENV=development NODE_ENV=development node --watch backend/server.js",
    "dev:frontend": "npm --prefix frontend run dev -- --mode development",
    "pm2:start": "pm2 startOrReload backend/ecosystem.config.cjs --update-env && pm2 save --force",
    "pm2:restart": "pm2 startOrReload backend/ecosystem.config.cjs --update-env && pm2 save --force",
    "pm2:stop": "pm2 stop raisoni-backend",
    "pm2:delete": "pm2 delete raisoni-backend && pm2 save --force",
    "pm2:status": "pm2 status",
    "pm2:logs": "pm2 logs raisoni-backend",
    "pm2:deploy": "npm run frontend:build:production && npm run pm2:restart",
    "pm2:autostart": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/pm2-autostart.ps1",
    "production": "npm run frontend:build && npm run start:production",
    "start": "npm run start:production",
    "start:development": "cross-env APP_ENV=development NODE_ENV=development node backend/server.js",
    "start:production": "cross-env APP_ENV=production NODE_ENV=production node backend/server.js",
    "server": "cross-env APP_ENV=development NODE_ENV=development node --watch backend/server.js",
    "seed": "npm run seed:development",
    "seed:development": "cross-env APP_ENV=development NODE_ENV=development node backend/scripts/seed.js",
    "seed:production": "cross-env APP_ENV=production NODE_ENV=production node backend/scripts/seed.js",
    "backup": "npm run backup:production",
    "backup:development": "cross-env APP_ENV=development NODE_ENV=development node backend/scripts/backup.js",
    "backup:production": "cross-env APP_ENV=production NODE_ENV=production node backend/scripts/backup.js",
    "planning-imports:clear:development": "cross-env APP_ENV=development NODE_ENV=development node backend/scripts/clear-planning-imports.js",
    "planning-imports:clear:production": "cross-env APP_ENV=production NODE_ENV=production node backend/scripts/clear-planning-imports.js",
    "env:development": "cross-env APP_ENV=development NODE_ENV=development node backend/scripts/show-environment.js",
    "env:production": "cross-env APP_ENV=production NODE_ENV=production node backend/scripts/show-environment.js",
    "test": "node --test backend/tests/*.test.js",
    "frontend": "npm run frontend:dev",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm run frontend:build:production",
    "production:build": "npm run frontend:build",
    "frontend:build:development": "npm --prefix frontend run build -- --mode development",
    "frontend:build:production": "npm --prefix frontend run build -- --mode production",
    "mongodb:download": "node scripts/download-mongodb.cjs",
    "server:firewall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/server-firewall.ps1",
    "desktop": "electron desktop/main.cjs",
    "desktop:dev": "cross-env RAISONI_SERVER_URL=http://localhost:9091 electron desktop/main.cjs",
    "pack": "npm run frontend:build:production && node scripts/package-electron.cjs --dir",
    "dist": "npm run frontend:build:production && node scripts/package-electron.cjs --bump-version",
    "dist:verify": "node scripts/verify-electron-package.cjs"
  },
  "keywords": [
    "electron",
    "react",
    "express",
    "mongodb",
    "lan-software",
    "offline-first"
  ],
  "author": "Raisoni ERP",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^10.1.3",
    "mongoose": "^8.9.5",
    "pm2": "^7.1.1",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.raisoni.erp",
    "productName": "Raisoni ERP",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "icon": "frontend/public/images/logo.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Raisoni ERP",
      "installerSidebar": "installer-assets/installer-sidebar.bmp",
      "uninstallerSidebar": "installer-assets/installer-sidebar.bmp"
    }
  }
}
